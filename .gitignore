/python/pdf_extract/pdf-extract-ocr-helper

# Local fuzzing state (tools/fuzz/run.sh): the persistent corpora, findings,
# the fuzz workspace's build output and coverage reports. The regression set
# (fuzz/regressions/), the unicode seeds and the ledger are committed.
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/target/
/fuzz/coverage/

