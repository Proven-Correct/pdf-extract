From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christophe Pettus <xof@thebuild.com>
Date: Thu, 1 Oct 2026 23:26:48 -0400
Subject: [PATCH 15/22] H10d: tell the device where forms and annotations begin
 and end

A device saw the glyphs of a Form XObject or an annotation appearance
stream interleaved with the page's own, with nothing to say where one
ended and the next began. Text extraction needs those boundaries to
keep the text of a form or an annotation from being merged with the
text around it.

`Device` gains four methods with empty default bodies, so existing
devices are unaffected:

- `begin_form(id)` / `end_form()` around the content of every Form
  XObject that is drawn, including nested forms and annotation
  appearance streams; `id` is the form's object identifier. A form that
  is not drawn (hidden by optional content, skipped as self-drawing or
  past the nesting cap, or after the budget ran out) gets no call.
- `begin_annotation(subtype)` / `end_annotation()` around each drawn
  annotation appearance, with the annotation's `/Subtype` (empty if it
  has none).

Marked content a form leaves open is closed before its `end_form`.
---
 hayro-interpret/src/device.rs        | 27 ++++++++++++++++++++++++++-
 hayro-interpret/src/interpret/mod.rs |  5 +++++
 hayro-interpret/src/x_object.rs      |  5 +++++
 3 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/hayro-interpret/src/device.rs b/hayro-interpret/src/device.rs
index cfa71fc..c51fe46 100644
--- a/hayro-interpret/src/device.rs
+++ b/hayro-interpret/src/device.rs
@@ -2,7 +2,7 @@ use crate::font::Glyph;
 use crate::soft_mask::SoftMask;
 use crate::{BlendMode, ClipPath, Image};
 use crate::{GlyphDrawMode, Paint, PathDrawMode};
-use hayro_syntax::object::Dict;
+use hayro_syntax::object::{Dict, ObjectIdentifier};
 use kurbo::{Affine, BezPath, Rect, Shape};
 
 /// A trait for a device that can be used to process PDF drawing instructions.
@@ -77,6 +77,31 @@ pub trait Device<'a> {
     }
     /// Called at the end of a marked content sequence (EMC).
     fn end_marked_content(&mut self) {}
+    /// Called before the content of a Form `XObject` is drawn, with the form's object
+    /// identifier (`None` for a form that is not an indirect object).
+    ///
+    /// Every call is matched by one [`end_form`](Device::end_form) after the form's
+    /// content; forms drawn inside the form (and annotation appearance streams, which are
+    /// forms) nest. A form that is not drawn at all (hidden by optional content, skipped
+    /// because it draws itself or is nested too deeply, or after the interpretation
+    /// budget ran out) causes no call. Text extraction uses the pair as a boundary
+    /// between the text inside the form and the text around it.
+    fn begin_form(&mut self, _id: Option<ObjectIdentifier>) {}
+    /// Called after the content of a Form `XObject` announced by
+    /// [`begin_form`](Device::begin_form) was drawn.
+    fn end_form(&mut self) {}
+    /// Called before the appearance stream of an annotation is drawn, with the
+    /// annotation's `/Subtype` (empty if it has none).
+    ///
+    /// Matched by one [`end_annotation`](Device::end_annotation). The appearance stream
+    /// itself is a form, so a [`begin_form`](Device::begin_form)/
+    /// [`end_form`](Device::end_form) pair normally follows inside, unless the form is
+    /// not drawn. Annotations that are not drawn (hidden, without an appearance stream,
+    /// or of a subtype that is never drawn) cause no call.
+    fn begin_annotation(&mut self, _subtype: &[u8]) {}
+    /// Called after the appearance stream of an annotation announced by
+    /// [`begin_annotation`](Device::begin_annotation) was drawn.
+    fn end_annotation(&mut self) {}
 }
 
 /// A device that discards all drawing operations.
diff --git a/hayro-interpret/src/interpret/mod.rs b/hayro-interpret/src/interpret/mod.rs
index 598d1dc..15299e1 100644
--- a/hayro-interpret/src/interpret/mod.rs
+++ b/hayro-interpret/src/interpret/mod.rs
@@ -393,6 +393,9 @@ pub fn interpret_page<'a>(
                 // 3) Matrix shall be concatenated with A to form a matrix
                 // AA that maps from the appearance’s coordinate system to
                 // the annotation’s rectangle in default user space.
+                let subtype = annot.get::<Name<'_>>(SUBTYPE);
+                device.begin_annotation(subtype.as_ref().map_or(&[][..], |s| s.as_ref()));
+
                 context.save_state();
                 context.pre_concat_affine(affine);
                 context.push_root_transform();
@@ -400,6 +403,8 @@ pub fn interpret_page<'a>(
                 draw_form_xobject(resources, &apx, context, device);
                 context.pop_root_transform();
                 context.restore_state(device);
+
+                device.end_annotation();
             }
         }
     }
diff --git a/hayro-interpret/src/x_object.rs b/hayro-interpret/src/x_object.rs
index 78a131a..a72c26c 100644
--- a/hayro-interpret/src/x_object.rs
+++ b/hayro-interpret/src/x_object.rs
@@ -135,6 +135,9 @@ pub(crate) fn draw_form_xobject<'a, 'b>(
         return;
     }
 
+    // From here on the form is drawn; see `Device::begin_form`.
+    device.begin_form(form_id);
+
     let iter = TypedIter::new(x_object.decoded.as_ref());
 
     context.path_mut().truncate(0);
@@ -196,6 +199,8 @@ pub(crate) fn draw_form_xobject<'a, 'b>(
         context.ocg_state.end_marked_content();
     }
 
+    device.end_form();
+
     context.end_nested_interpretation();
 }
 
